# Optional. The app is fully functional without a key (template explanations).
# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Model for the AI answers layer. Default: gemini-3.6-flash.
# gemini-2.0-flash was retired by Google on 2026-06-01; pick any served model
# from https://aistudio.google.com/docs/deprecations
GEMINI_MODEL=gemini-3.6-flash

# Optional. Bind host/port for uvicorn (defaults: 127.0.0.1:8000)
HOST=127.0.0.1
PORT=8000
